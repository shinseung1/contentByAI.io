# ============================================================================
# AI Writer Environment Configuration Example
# Copy this file to .env and fill in your actual values
# ============================================================================

# 애플리케이션 기본 설정
APP_ENV=development
TZ=Asia/Seoul
LOG_LEVEL=INFO

# 데이터베이스 설정
DATABASE_URL=sqlite:///data/aiwriter.db

# API 서버 설정
API_HOST=127.0.0.1
API_PORT=8000
WEB_HOST=127.0.0.1
WEB_PORT=3000

# ============================================================================
# AI 서비스 API 키 설정 (필수 - 하나 이상 설정 필요)
# ============================================================================

# Primary AI Provider 선택 (claude, openai, gemini, grok)
PRIMARY_AI_PROVIDER=claude
AI_FALLBACK_ENABLED=true

# Claude API (Anthropic) - https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-3-sonnet-20240229

# OpenAI API (ChatGPT) - https://platform.openai.com/
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Google Gemini API - https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-1.5-pro

# Grok API (X.AI) - https://console.x.ai/
GROK_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROK_MODEL=grok-beta

# AI 공통 설정
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7

# ============================================================================
# WordPress 플랫폼 설정 (선택사항)
# ============================================================================

# WordPress 기본 정보
WP_BASE_URL=https://your-wordpress-site.com
WP_APP_USER=your-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# WordPress 기본 설정
WP_DEFAULT_STATUS=draft
WP_DEFAULT_CATEGORY=일반
WP_AUTHOR_ID=1

# ============================================================================
# Google Blogger 플랫폼 설정 (선택사항)
# ============================================================================

# Google OAuth2 설정 - Google Cloud Console에서 발급
GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=XXXXXX-XXXXXXXXXXXXXXXXXXXXXXXX
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Blogger 설정
BLOGGER_BLOG_ID=1234567890123456789
BLOGGER_DEFAULT_STATUS=DRAFT

# ============================================================================
# 이미지 생성 및 저장 설정
# ============================================================================

# 이미지 설정
INCLUDE_IMAGES=true
MAX_IMAGES_PER_POST=3
IMAGE_QUALITY=high
IMAGE_FORMAT=webp

# 외부 이미지 서비스 (선택사항)
UNSPLASH_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# 콘텐츠 생성 기본 설정
# ============================================================================

# 콘텐츠 기본 설정
DEFAULT_TONE=professional
DEFAULT_WORD_COUNT=800
DEFAULT_LANGUAGE=ko
TARGET_SEO_SCORE=85

# 품질 검사 설정
ENABLE_QUALITY_CHECK=true
MIN_QUALITY_SCORE=75
ENABLE_SPELL_CHECK=true

# ============================================================================
# 보안 및 API 제한 설정
# ============================================================================

# 레이트 리미팅
GENERATION_RATE_LIMIT_PER_HOUR=100
PUBLISHING_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=1000

# 요청 타임아웃 (초)
HTTP_TIMEOUT=30
AI_REQUEST_TIMEOUT=120

# CORS 설정
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# 파일 저장 경로 설정
# ============================================================================

# 저장 경로
BUNDLES_DIR=bundles
LOGS_DIR=logs
RUNS_DIR=runs
DATA_DIR=data

# ============================================================================
# 개발/테스트 설정
# ============================================================================

# 디버그 모드
DEBUG=false
VERBOSE_LOGGING=false

# 테스트 모드 (실제 발행 안함)
TEST_MODE=false

# 개발용 Mock API 사용
USE_MOCK_AI=false